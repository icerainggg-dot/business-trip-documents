<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS 배포용: wasm / traineddata.gz MIME 등록 -->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- 업데이트 후 브라우저가 옛 js/서식 파일을 쓰지 않도록 매번 재확인 -->
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".gz" />
      <mimeMap fileExtension=".gz" mimeType="application/octet-stream" />
      <remove fileExtension=".bcmap" />
      <mimeMap fileExtension=".bcmap" mimeType="application/octet-stream" />
      <remove fileExtension=".pfb" />
      <mimeMap fileExtension=".pfb" mimeType="application/octet-stream" />
    </staticContent>
  </system.webServer>
</configuration>
